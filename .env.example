CAIAE_API_BASE_URL=http://localhost:4000
# Optional until an organization is provisioned in the engine.
CAIAE_ORGANIZATION_ID=

# Server-side/operator provisioning only. Never expose this as public web config.
CAIAE_OPERATOR_TOKEN=

# Optional when reusing an already-created policy record.
FDEA_POLICY_ID=

# Leave unset while the source remains draft legislation.
# Supply an enactment/effective timestamp only when activation is legally appropriate.
FDEA_EFFECTIVE_FROM=


# Evaluation harness
FDEA_FIXTURE=fully-compliant-system
FDEA_EVALUATION_MODE=simulation
FDEA_REGISTERED_RULESET_ID=
FDEA_EVALUATED_AT=
FDEA_SYNC_FINDINGS=false
CAIAE_PRINCIPAL_ID=
